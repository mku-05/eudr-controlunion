# All optional. Defaults shown.
EUDR_DATA_DIR=./data
EUDR_DB_URL=                      # empty → sqlite under data dir; e.g. postgresql+psycopg://user:pw@host/eudr
EUDR_GEO_PROVIDER=public          # public | mock
EUDR_HANSEN_VERSION=GFC-2024-v1.12
EUDR_TREE_COVER_THRESHOLD=30
EUDR_CLAUDE_CONFIG_DIR=~/.claude-personal
EUDR_MODEL_REASONING=claude-opus-5
EUDR_MODEL_FAST=claude-sonnet-5
EUDR_ANALYST_AUTO_ACCEPT_CONFIDENCE=0.85
EUDR_AGENTS=1                     # 0 → deterministic path only (no Claude calls)
